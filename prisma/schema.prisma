datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  MANAGEMENT
  USER
}

enum EmploymentType {
  PKWT
  PKWTT
  MAGANG
}

enum ContractStatus {
  AKTIF
  AKAN_BERAKHIR
  EXPIRED
  DIPERPANJANG
  DIANGKAT_TETAP
  RESIGN
}

enum NotificationChannel {
  EMAIL
  WHATSAPP
  IN_APP
}

enum SubmissionType {
  EXTENSION
  DATA_UPDATE
  RESIGNATION
  OTHER
}

enum SubmissionStatus {
  PENDING
  DIPROSES
  DISETUJUI
  DITOLAK
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  password     String
  name         String
  role         Role      @default(USER)
  isActive     Boolean   @default(true)
  employeeId   String?   @unique
  employee     Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  contractsCreated     Contract[]          @relation("ContractCreatedBy")
  historyCreated       ContractHistory[]   @relation("HistoryChangedBy")
  submissionsProcessed SubmissionForm[]    @relation("SubmissionProcessedBy")
  evaluationsCreated   ContractEvaluation[] @relation("EvaluationCreatedBy")
  notifications        InAppNotification[]
  auditLogs            AuditLog[]
}

model Employee {
  id             String         @id @default(uuid())
  nik            String         @unique
  name           String
  email          String?        @unique
  phone          String?
  department     String
  position       String
  level          String?
  employmentType EmploymentType @default(PKWT)
  joinDate       DateTime
  user           User?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  contracts   Contract[]
  submissions SubmissionForm[]
  evaluations ContractEvaluation[]
}

model Contract {
  id             String         @id @default(uuid())
  employeeId     String
  employee       Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  contractNumber String?
  contractType   EmploymentType @default(PKWT)
  sequence       Int            @default(1)
  startDate      DateTime
  endDate        DateTime
  status         ContractStatus @default(AKTIF)
  documentUrl    String?
  notes          String?
  createdById    String?
  createdBy      User?          @relation("ContractCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  history       ContractHistory[]
  notifications NotificationLog[]
  inAppNotifications InAppNotification[]
  evaluations   ContractEvaluation[]
}

model ContractHistory {
  id           String   @id @default(uuid())
  contractId   String
  contract     Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  changeType   String
  previousData String?
  newData      String?
  changedById  String?
  changedBy    User?    @relation("HistoryChangedBy", fields: [changedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
}

model NotificationRule {
  id          String                 @id @default(uuid())
  name        String
  daysBefore  Int
  channels    NotificationChannel[]
  targetRoles Role[]
  template    String
  isActive    Boolean                @default(true)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
}

model NotificationLog {
  id         String              @id @default(uuid())
  contractId String?
  contract   Contract?           @relation(fields: [contractId], references: [id], onDelete: SetNull)
  recipient  String
  channel    NotificationChannel
  status     String              @default("SENT")
  message    String
  error      String?
  sentAt     DateTime            @default(now())
}

model InAppNotification {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String
  message         String
  link            String?
  contractId      String?
  contract        Contract? @relation(fields: [contractId], references: [id], onDelete: SetNull)
  whatsappPhone   String?
  whatsappMessage String?
  isRead          Boolean   @default(false)
  createdAt       DateTime  @default(now())
}

model SubmissionForm {
  id             String           @id @default(uuid())
  employeeId     String
  employee       Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  submissionType SubmissionType
  status         SubmissionStatus @default(PENDING)
  reason         String
  remarks        String?
  processedById  String?
  processedBy    User?            @relation("SubmissionProcessedBy", fields: [processedById], references: [id], onDelete: SetNull)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())
}

model Department {
  id        String   @id @default(uuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Position {
  id        String   @id @default(uuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ContractEvaluation {
  id                 String    @id @default(uuid())
  documentNumber     String?
  employeeId         String
  employee           Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  contractId         String?
  contract           Contract? @relation(fields: [contractId], references: [id], onDelete: SetNull)

  periodEnd          DateTime?
  employeeLevel      String?   // Staff vs Non-Staff

  scoresJson         String    // JSON string containing individual scores e.g. { "1": 4, "2": 3, ... }
  statementsJson     String?   // JSON string containing statement checklists { "1": true, "2": true, "3": true }

  totalScore         Float     // Sum of scores
  averageScore       Float     // Computed average score (1.00 - 4.00)
  ratingGrade        String?   // TIDAK MEMUASKAN, KURANG MEMUASKAN, CUKUP MEMUASKAN, MEMUASKAN

  recommendationType String    // LANJUT_KONTRAK | SELESAI_KONTRAK
  recommendationDuration Int?  // 3, 6, 12 months if LANJUT_KONTRAK

  evaluatorName      String?
  evaluatorPosition  String?
  evaluatorEmail     String?
  evaluatorPhone     String?
  accessToken        String?   @unique
  tokenExpiresAt     DateTime?
  knownByName        String?
  knownByPosition    String?
  checkedByName      String?
  checkedByPosition  String?
  approvedByName     String?
  approvedByPosition String?

  evaluationDate     DateTime?
  submittedDate      DateTime?
  notes              String?

  status             String    @default("COMPLETED") // DRAFT, COMPLETED
  createdById        String?
  createdBy          User?     @relation("EvaluationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}