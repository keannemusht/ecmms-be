<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{en.title}}</title>
</head>
<body style="margin:0; padding:0; background-color:#F6F5F2; font-family:Inter, Helvetica, Arial, sans-serif; color:#151B26; -webkit-font-smoothing:antialiased;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#F6F5F2; padding:24px 0;">
    <tr>
      <td align="center">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:560px; background-color:#FFFFFF; border-radius:10px; overflow:hidden; border:1px solid #DCD9D1;">

          <!-- Header -->
          <tr>
            <td style="background-color:#FFFFFF; padding:20px 28px; border-bottom:3px solid #9C6B2E;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                <tr>
                  {{#if logoUrl}}
                  <td valign="middle" style="padding-right:16px; width:140px;">
                    <img src="{{logoUrl}}" alt="Logo" width="140" style="display:block; width:140px; max-width:140px; height:auto; border:0;" />
                  </td>
                  {{/if}}
                  <td valign="middle" style="text-align:left;">
                    <span style="font-size:16px; font-weight:700; color:#9C6B2E; letter-spacing:0.5px; display:block;">{{appName}}</span>
                    <span style="font-size:11px; color:#4B5563; margin-top:3px; display:block; line-height:1.3;">{{appTagline}}</span>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- Body: English -->
          <tr>
            <td style="padding:28px 32px 8px;">
              <p style="margin:0 0 6px; font-size:11px; font-weight:600; text-transform:uppercase; letter-spacing:0.08em; color:#9C6B2E;">{{en.title}}</p>
              <h1 style="margin:0 0 16px; font-size:18px; font-weight:700; color:#151B26;">{{en.heading}}</h1>
              <p style="margin:0 0 20px; font-size:13px; line-height:1.6; color:#4B5563;">{{en.message}}</p>

              {{#if en.details}}
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse; margin-bottom:20px;">
                {{#each en.details}}
                <tr>
                  <td style="padding:8px 12px; font-size:11px; font-weight:600; color:#4B5563; background-color:#ECEAE4; border:1px solid #DCD9D1; width:42%;">{{label}}</td>
                  <td style="padding:8px 12px; font-size:12px; font-weight:600; color:#151B26; border:1px solid #DCD9D1;">{{value}}</td>
                </tr>
                {{/each}}
              </table>
              {{/if}}

              <p style="margin:0; font-size:11px; line-height:1.5; color:#4B5563;">{{en.footerText}}</p>
            </td>
          </tr>

          <!-- Divider -->
          <tr>
            <td style="padding:16px 32px 0;">
              <div style="border-top:1px solid #DCD9D1;"></div>
            </td>
          </tr>

          <!-- Body: Indonesia -->
          <tr>
            <td style="padding:24px 32px 28px;">
              <p style="margin:0 0 6px; font-size:11px; font-weight:600; text-transform:uppercase; letter-spacing:0.08em; color:#9C6B2E;">{{id.title}}</p>
              <h1 style="margin:0 0 16px; font-size:18px; font-weight:700; color:#151B26;">{{id.heading}}</h1>
              <p style="margin:0 0 20px; font-size:13px; line-height:1.6; color:#4B5563;">{{id.message}}</p>

              {{#if id.details}}
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse; margin-bottom:20px;">
                {{#each id.details}}
                <tr>
                  <td style="padding:8px 12px; font-size:11px; font-weight:600; color:#4B5563; background-color:#ECEAE4; border:1px solid #DCD9D1; width:42%;">{{label}}</td>
                  <td style="padding:8px 12px; font-size:12px; font-weight:600; color:#151B26; border:1px solid #DCD9D1;">{{value}}</td>
                </tr>
                {{/each}}
              </table>
              {{/if}}

              <p style="margin:0; font-size:11px; line-height:1.5; color:#4B5563;">{{id.footerText}}</p>
            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td style="padding:18px 32px; border-top:1px solid #DCD9D1; background-color:#F6F5F2;">
              <p style="margin:0; font-size:10px; color:#4B5563;"> PT BATARA DHARMA PERSADA - ECMMS </p>
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>
</body>
</html>
